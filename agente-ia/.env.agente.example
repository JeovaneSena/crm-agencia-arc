# Copy to .env.agente.local. Secrets are server-only; never use VITE_ prefixes.
# Populate only the integrations used by this installation.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Meta Cloud API — app and number belonging to THIS installation.
# Use a system user token for production. A temporary token is only for tests.
META_ACCESS_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Set an explicitly supported Graph version from the Meta app dashboard, e.g. vNN.0.
META_GRAPH_VERSION=
# Independent random secret used by the scheduled queue worker.
META_WORKER_SECRET=
CAMPANHAS_WORKER_SECRET=
# Opcional: 1 a 50; a cadência final continua controlada no banco.
CAMPANHAS_LOTE_POR_EXECUCAO=10
# Outro segredo aleatório, só do trabalhador de lembretes de reunião.
LEMBRETES_WORKER_SECRET=
LEMBRETES_LOTE_POR_EXECUCAO=10

# uazapi — instance token, not an admin token.
UAZAPI_API_URL=
UAZAPI_TOKEN=
# Secret included in the uazapi webhook URL (?segredo=...).
WEBHOOK_SEGREDO=
